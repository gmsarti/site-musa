{
  "name": "site-musa",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Pousada Musa — Engenhos, Iguape/SP",
  "scripts": {
    "build": "npm run build:css && npm run build:i18n",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build:i18n": "node scripts/build-i18n.mjs",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "test": "node scripts/check-site.mjs",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18"
  }
}
